# Copy this to .env and fill in your values for local development.
# Docker Compose sets these automatically — this file is only for manual local runs.

# Leave DATABASE_URL unset to use SQLite (easiest for local dev)
# DATABASE_URL=postgresql://promptuser:promptpass@localhost:5432/promptlib

# Leave REDIS_URL unset or point to a local Redis instance
# REDIS_URL=redis://localhost:6379/0

SECRET_KEY=dev-secret-key-change-me
JWT_SECRET=dev-jwt-secret-change-me
DEBUG=True
ALLOWED_HOSTS=*
